@model BookModel

@{
    ViewData["Title"] = "Book Details - " + Model.Title;
}

<div class="container mt-5">

    <h2 class="mb-4">Book Details</h2>

    <div class="row">

        <!-- ========================= -->
        <!-- Book Gallery / Carousel -->
        <!-- ========================= -->

        <div class="col-md-6">

            @if (Model.Gallery != null && Model.Gallery.Count > 0)
            {
                <div id="bookCarousel"
                     class="carousel slide"
                     data-ride="carousel">

                    <!-- Indicators -->

                    <ol class="carousel-indicators">

                        @for (int i = 0; i < Model.Gallery.Count; i++)
                        {
                            <li data-target="#bookCarousel"
                                data-slide-to="@i"
                                class="@(i == 0 ? "active" : "")">
                            </li>
                        }

                    </ol>


                    <!-- Carousel Images -->

                    <div class="carousel-inner">

                        @for (int i = 0; i < Model.Gallery.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">

                                <img src="@Model.Gallery[i].URL"
                                     class="d-block w-100 carousel-image"
                                     alt="@Model.Gallery[i].Name" />

                            </div>
                        }

                    </div>


                    <!-- Previous -->

                    <a class="carousel-control-prev"
                       href="#bookCarousel"
                       role="button"
                       data-slide="prev">

                        <span class="carousel-control-prev-icon"
                              aria-hidden="true">
                        </span>

                        <span class="sr-only">
                            Previous
                        </span>

                    </a>


                    <!-- Next -->

                    <a class="carousel-control-next"
                       href="#bookCarousel"
                       role="button"
                       data-slide="next">

                        <span class="carousel-control-next-icon"
                              aria-hidden="true">
                        </span>

                        <span class="sr-only">
                            Next
                        </span>

                    </a>

                </div>
            }
            else
            {
                <div class="text-center">

                    <img src="@Model.CoverImageUrl"
                         class="img-fluid rounded"
                         alt="@Model.Title" />

                </div>
            }

        </div>


        <!-- ========================= -->
        <!-- Book Information -->
        <!-- ========================= -->

        <div class="col-md-6">

            <h1>
                @Model.Title
            </h1>

            <p class="text-primary">
                <strong>By:</strong>
                @Model.Author
            </p>

            <p class="description">
                @Model.Description
            </p>


            <!-- Read Now -->
            @if (!string.IsNullOrEmpty(Model?.BookPdfUrl))
            {
                <!-- Primary modal trigger -->
                <button type="button"
                        class="btn btn-outline-primary mb-4 mr-2"
                        data-toggle="modal"
                        data-target="#bookPdfModal">
                    Read Now
                </button>

                <!-- Direct link fallback in case JS/modal fails -->
                <a class="btn btn-primary mb-4" href="@Model.BookPdfUrl" target="_blank" rel="noopener noreferrer">Open PDF</a>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary mb-4" disabled>Preview not available</button>
            }


            <!-- Book Information -->

            <ul class="list-group">

                <li class="list-group-item">
                    <strong>Category:</strong>
                    @Model.Category
                </li>

                <li class="list-group-item">
                    <strong>Total Pages:</strong>
                    @Model.TotalPages
                </li>

                <li class="list-group-item">
                    <strong>Language:</strong>
                    @Model.Language
                </li>

            </ul>

        </div>

    </div>


    <!-- ========================= -->
    <!-- PDF Modal -->
    <!-- ========================= -->
    @if (!string.IsNullOrEmpty(Model.BookPdfUrl))
    {
        <div class="modal fade"
             id="bookPdfModal"
             tabindex="-1"
             role="dialog"
             aria-labelledby="bookPdfModalTitle"
             aria-hidden="true">

        <div class="modal-dialog modal-xl modal-dialog-centered"
                 role="document">

                <div class="modal-content">

                    <div class="modal-header">

                        <h5 class="modal-title"
                            id="bookPdfModalTitle">

                            @Model.Title

                        </h5>

                        <button type="button"
                                class="close"
                                data-dismiss="modal"
                                aria-label="Close">

                            <span aria-hidden="true">&times;</span>

                        </button>

                    </div>

                    <div class="modal-body p-0">

                        <!-- Use iframe for better cross-browser PDF rendering and allow fullscreen -->
                        <iframe id="bookPdfIframe" src="" frameborder="0" width="100%" height="80vh" allowfullscreen></iframe>

                    </div>

                    <div class="modal-footer">

                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>

                    </div>

                </div>

            </div>

        </div>
    }


    <!-- ========================= -->
    <!-- Similar Books -->
    <!-- ========================= -->

    <hr class="my-5" />

    <div class="py-5 bg-light">

        <h3 class="mb-4">
            Similar Books
        </h3>

        <div class="row">

            <div class="col-12">

                <div class="alert alert-info">
                    Similar books will appear here.
                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <script>
        $(document).ready(function () {

            // Initialize carousel manually
            $('#bookCarousel').carousel({
                interval: 3000,
                ride: 'carousel'
            });

            // When the PDF modal is shown, set the iframe src to the PDF URL to start loading.
            $('#bookPdfModal').on('show.bs.modal', function () {
                var pdfUrl = '@(Model?.BookPdfUrl ?? "")';
                if (pdfUrl) {
                    $('#bookPdfIframe').attr('src', pdfUrl);
                }
            });

            // When the modal is hidden, clear the iframe src to stop PDF playback/download.
            $('#bookPdfModal').on('hidden.bs.modal', function () {
                $('#bookPdfIframe').attr('src', '');
            });

        });

    </script>
}
