@model RizTechBookStore.Models.SignInModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Login</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet"
          href="~/lib/twitter-bootstrap/css/bootstrap.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/Site.css" />
</head>
<body>

    <div class="container mt-5">
        <h4>Login</h4>
        <hr />

        <div class="row align-items-center">

            <!-- Left Side: Signup Form -->
            <div class="col-md-6">
                <form method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Email" class="control-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Password" class="control-label"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group form-check">
                        <label asp-for="RememberMe" class="form-check-label">
                            <input asp-for="RememberMe" class="form-check-input" />
                            @Html.DisplayNameFor(model => model.RememberMe)
                        </label>
                    </div>

                    <div class="form-group mb-3">
                        <input type="submit" value="Login" class="btn btn-primary" />
                    </div>

                </form>

                <div>
                    <p><a asp-controller="Account" asp-action="ForgotPassword">Forgot Password?</a></p>
                    <p>Click <a asp-controller="Account" asp-action="Signup">here</a> to Register</p> 
                </div>
            </div>

            <!-- Right Side: Signup Image -->
            <div class="col-md-6 text-center">
                <img src="~/images/login.png" alt="Login" class="img-fluid signup-image" />
            </div>

        </div>
    </div>

</body>
</html>
